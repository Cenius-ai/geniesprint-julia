# GenieTeam environment — all variables are OPTIONAL.
# A fresh clone boots with no .env at all; these are the knobs to override.

# HTTP port the web server binds (framework default 8000).
PORT=8000

# Embedded SQLite database path, relative to the project root.
GENIETEAM_DB_PATH=./data/genieteam.db

# Session signing key. For production set a long random value, e.g. from
# `openssl rand -hex 32`. When empty/missing the app uses a clearly-marked
# DEV-ONLY fallback so a fresh clone still boots.
GENIETEAM_SECRET=
